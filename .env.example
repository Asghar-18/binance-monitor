# Copy this file to .env and fill it in. Never commit .env.

# --- Binance ------------------------------------------------------------
# Create a key with ONLY "Enable Reading" ticked. The app refuses to start
# if the key can trade, transfer or withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Secrets you make up ------------------------------------------------
# Generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
API_TOKEN=
DASHBOARD_PASSWORD=
# Signs your login cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=
# 2FA key for Google Authenticator. Generate with:
#   python3 -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
DASHBOARD_TOTP_SECRET=

# --- Phone alerts: ntfy (works without a VPN) ---------------------------
# Install the ntfy app and subscribe to this exact topic name.
# The topic name works like a password: make it long and random.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# --- Telegram (optional, extra channel; needs Telegram to be reachable) --
# From @BotFather (/newbot). Leave empty if you only use ntfy.
TELEGRAM_BOT_TOKEN=

# https address of your dashboard, for the "Open dashboard" button (optional)
DASHBOARD_URL=

# --- Alerts (defaults shown) ----------------------------------------------
# Thresholds (P/L % from your average entry) given to every coin you hold
DEFAULT_THRESHOLDS=-5,-10,10,20
# A fired threshold re-arms after P/L moves back this many points
ALERT_HYSTERESIS_PCT=1
# Minimum minutes between alerts for the same coin (a deeper threshold still goes through)
ALERT_COOLDOWN_MIN=120
# Silent "approaching" alert this many points before a threshold (0 = off)
WATCH_MARGIN_PCT=1
# Skip "approaching" alerts during these hours; threshold alerts always send
QUIET_HOURS=23-7
TIMEZONE=Asia/Karachi

# --- Claude analysis (optional) -------------------------------------------
# API key from https://console.anthropic.com (Settings -> API keys).
# Without it, alerts still work, just without the plain-English explanation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# The app stops calling Claude for the rest of the month after this much spend
LLM_MONTHLY_BUDGET_USD=5

# --- Morning summary ------------------------------------------------------
# Local time (TIMEZONE) for the daily summary, or "off"
DIGEST_TIME=09:00

# --- Server with a domain (only for: docker compose --profile https up) -
DOMAIN=portfolio.example.com

# --- Optional tuning ----------------------------------------------------
# Quote currencies to import trade history for
QUOTE_ASSETS=USDT,FDUSD,USDC,BTC,ETH,BNB
# Hide balances worth less than this many USD
DUST_USD=5
# How far back to import Convert history on first run (days)
CONVERT_LOOKBACK_DAYS=365

# --- Only when running the backend outside Docker -----------------------
# DATABASE_URL=postgres://monitor:YOUR_POSTGRES_PASSWORD@localhost:5432/monitor
